{
  id: "MainMenu"

  templates: {
    ParchmentButton: {
      type: "coc:button"
      backgroundColor: "#EBDCC0FF"
      width: 340
      height: 44
      layout: "relative"
    }
  }

  root: {
    type: "coc:view"
    width: 1600
    height: 900

    children: [
      {
        type: "coc:panel"
        x: 0
        y: 0
        width: 1600
        height: 900
        backgroundColor: "#F2E5C7FF"
        canHit: false

        material: "coc:paper"
      }
      {
        type: "coc:image"
        texture: "coc:CoCLogo"
        x: 60
        y: 58
        width: 420
        height: 255
        canHit: false
      }
      {
        type: "coc:grid"
        x: 72
        y: 356
        rows: 8
        columns: 1
        spacing: 10
        autoSize: true
        children: [
          {
            template: "ParchmentButton"
            labelKey: "MainMenu.Button.Continue"
            onClick: "main.continue"
            hintKey: "MainMenu.Button.ContinueHint"
            gridIndex: 0
          }
          {
            template: "ParchmentButton"
            labelKey: "MainMenu.Button.NewGame"
            onClick: "main.new_game"
            hintKey: "MainMenu.Button.NewGameHint"
            gridIndex: 1
          }
          {
            template: "ParchmentButton"
            labelKey: "MainMenu.Button.LoadGame"
            onClick: "main.load_game"
            hintKey: "MainMenu.Button.LoadGameHint"
            gridIndex: 2
          }
          {
            template: "ParchmentButton"
            labelKey: "MainMenu.Button.Options"
            onClick: "main.options"
            hintKey: "MainMenu.Button.OptionsHint"
            gridIndex: 3
          }
          {
            template: "ParchmentButton"
            labelKey: "MainMenu.Button.Achievements"
            onClick: "main.achievements"
            hintKey: "MainMenu.Button.AchievementsHint"
            gridIndex: 4
          }
          {
            template: "ParchmentButton"
            labelKey: "MainMenu.Button.Instructions"
            onClick: "main.instructions"
            hintKey: "MainMenu.Button.InstructionsHint"
            gridIndex: 5
          }
          {
            template: "ParchmentButton"
            labelKey: "MainMenu.Button.Credits"
            onClick: "main.credits"
            hintKey: "MainMenu.Button.CreditsHint"
            gridIndex: 6
          }
          {
            template: "ParchmentButton"
            labelKey: "MainMenu.Button.Quit"
            onClick: "main.quit"
            hintKey: "MainMenu.Button.QuitHint"
            gridIndex: 7
          }
        ]
      }
    ]
  }
}
