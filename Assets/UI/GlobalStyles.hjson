{
  id: "GlobalStyles"

  componentTemplates: {
    "coc:ParchmentButton": {
      type: "coc:panel"
      sizeType: "fill"
      canHit: false

      children: [
        {
          type: "coc:border"
          part: "border"
          sizeType: "fill"
          thickness: 2
          inset: 1

          states: {
            normal: { color: "#9F8156FF" }
            hover: { color: "#704D28FF" }
            pressed: { color: "#704D28FF" }
            disabled: { color: "#8C7E6CFF" }
          }
        }
        {
          type: "coc:corners"
          part: "corners"
          sizeType: "fill"
          length: 14
          thickness: 2
          gap: 2
          inset: 5

          states: {
            normal: {
            }
            hover: {
              color: "#8B6B42FF"
            }
            pressed: {
              color: "#5E3F21FF"
            }
          }
        }
        {
          type: "coc:label"
          part: "content"
          font: "coc:button"
          textHorizontalAlign: "center"
          x: 0
          y: 8
          width: 340
          height: 28
          wrapWidth: 340
          canHit: false
        }
      ]
    }
    "coc:Hint": {
      type: "coc:panel"
      canHit: false
      backgroundColor: "#F2E5C7FF"

      children: [
        {
          type: "coc:border"
          sizeType: "fill"
          thickness: 2
          inset: 1

          states: {
            normal: { color: "#9F8156FF" }
          }
        }
        {
          type: "coc:corners"
          sizeType: "fill"
          length: 14
          thickness: 2
          gap: 2
          inset: 5

          states: {
            normal: {
              color: "#8B6B42FF"
            }
          }
        }
        {
          type: "coc:label"
          part: "header"
          font: "coc:tooltipHeader"
          x: 18
          y: 15
          width: 384
          height: 25
          wrapWidth: 384
          canHit: false
        }
        {
          type: "coc:divider"
          x: 18
          y: 40
          width: 384
          height: 1
          thickness: 1
          ornament: false

          states: {
            normal: { color: "#9F8156FF" }
          }
        }
        {
          type: "coc:label"
          part: "body"
          font: "coc:tooltipBody"
          x: 18
          y: 44
          width: 384
          height: 120
          wrapWidth: 384
          canHit: false
        }
      ]
    }
  }

  styles: {
    TabButton: {
      type: "coc:button"
      width: 200
      height: 60
      horizontalAlign: "center"
      font: { id: "coc:menu", size: 20 }
      states: {
        normal: { textColor: "#7C6B58CC" }
        hover: { textColor: "#2F241BFF" }
        selected: { backgroundColor: "#E0C9AAFF", textColor: "#2F241BFF" }
      }
    }
    FooterButton: {
      type: "coc:button"
      width: 180
      height: 56
      backgroundColor: "#00000000"
      borderThickness: 0
      font: { id: "coc:menu", size: 20 }
      states: {
        normal: { textColor: "#7C6B58FF", backgroundColor: "#00000000" }
        hover: { textColor: "#2F241BFF", backgroundColor: "#DCC7A6AA" }
        pressed: { textColor: "#2F241BFF", backgroundColor: "#C9AE88CC" }
      }
    }
    MenuRowButton: {
      type: "coc:button"
      style: "FooterButton"
      width: 400
      height: 48
      labelPadding: 56
      textHorizontalAlign: "left"
      iconSize: 24
      iconX: 20
      iconY: 12
      iconColor: "#5A4630FF"
      iconHoverColor: "#2F241BFF"
    }
    ParchmentButton: {
      type: "coc:button"
      backgroundColor: "#EBDCC0FF"
      width: 340
      height: 44
      borderThickness: 2
      horizontalAlign: "center"
      componentTemplate: "coc:ParchmentButton"

      states: {
        normal: {
          backgroundColor: "#EBDCC0FF"
          borderColor: "#9F8156FF"
          textColor: "#3B2C1DFF"
        }
        hover: {
          backgroundColor: "#E0CA9FFF"
          borderColor: "#704D28FF"
          textColor: "#3B2C1DFF"
        }
        pressed: {
          backgroundColor: "#CFB17FFF"
          borderColor: "#704D28FF"
          textColor: "#3B2C1DFF"
        }
        selected: {
          backgroundColor: "#D5D8B8FF"
          borderColor: "#858B62FF"
          textColor: "#2F241BFF"
        }
        disabled: {
          backgroundColor: "#C4B8A6FF"
          borderColor: "#8C7E6CFF"
          textColor: "#7A7062FF"
        }
      }

      hint: {
        componentTemplate: "coc:Hint"
        width: 420
        minHeight: 180
        padding: 18
        direction: "right"
        distance: 8
        offsetX: 0
        offsetY: 0
        headerColor: "#3B2C1DFF"
        bodyColor: "#3B2C1DFF"
        separatorColor: "#9F8156FF"
      }
    }
    ActionButton: {
      type:"coc:button", 
      style: "ParchmentButton",
      width: 180, 
      height: 40, 
      verticalAlign: "center", 
      horizontalAlign: "center"
      hint: {
        componentTemplate: "coc:Hint"
        width: 420
        minHeight: 0
        padding: 18
        direction: "top"
        backgroundColor: "#F2E5C7FF"
        borderColor: "#9F8156FF"
        borderThickness: 1
        headerColor: "#3B2C1DFF"
        bodyColor: "#3B2C1DFF"
        separatorColor: "#9F8156FF"
      }
    }

    SaveSlotIcon: {
      type: "coc:button"
      width: 34
      height: 34
      fitLabel: false
      backgroundColor: "#00000000"
      borderThickness: 0
      hint: {
        componentTemplate: "coc:Hint"
        width: 420
        minHeight: 0
        padding: 18
        direction: "top"
        headerColor: "#3B2C1DFF"
        bodyColor: "#3B2C1DFF"
        separatorColor: "#9F8156FF"
      }
    }

    ContextMenu: {
      type: "coc:context_menu"
      width: 160
      itemHeight: 40
      spacing: 2
      menuPadding: 4
      itemStyle: "MenuItem"
      visible: false
      states: {
        normal: { backgroundColor: "#F7EFE0FF", borderColor: "#B79A70FF", borderThickness: 1 }
      }
    }

    MenuItem: {
      type: "coc:button"
      height: 36
      textHorizontalAlign: "left"
      labelPadding: 10
      font: { id: "coc:body", size: 18 }
      states: {
        normal: { backgroundColor: "#00000000", textColor: "#35291FFF" }
        hover: { backgroundColor: "#E0C9AAFF", textColor: "#35291FFF" }
      }
    }
  }

  components: {
    scrollBar: {
      thickness: 15
      minThumb: 24
      track: "#ECE0C4FF"
      thumb: "#B79A70FF"
      consoleThumb: "#8A8A8ACC"
      revealDistance: 28
      fadeInSpeed: 8
      fadeOutSpeed: 4
    }

    textBox: {
      text: "#000000FF"
      border: "#000000FF"
      borderThickness: 1
      cursor: "#000000FF"
      selection: "#31405172"
    }

    searchBar: {
      background: "#EEE4CDFF"
      border: "#5C4126FF"
      borderThickness: 1
      hint: "#7D694EFF"
      text: "#281E14FF"
    }

    toolTip: {
      text: "#000000FF"
      separator: "#000000FF"
    }

    dropdown: {
      headerText: "#35291FFF"
      listBackground: "#F7EFE0FF"
      itemText: "#35291FFF"
    }

    dropdownHeader: {
      normal: { background: "#F7EFE0FF", border: "#B79A70FF", borderThickness: 1 }
      hover: { background: "#EFE3CCFF", border: "#9F8156FF", borderThickness: 1 }
      pressed: { background: "#E0C9AAFF", border: "#9F8156FF", borderThickness: 1 }
    }

    settingsChip: {
      normalText: "#7C6B58CC"
      hoverText: "#2F241BFF"
      selectedText: "#2F241BFF"
      selectedBackground: "#D5D8B8FF"
      selectedBorder: "#858B62FF"
      selectedBorderThickness: 2
    }

    keyChip: {
      fill: "#D5D8B8FF"
      fillHover: "#DDDFC4FF"
      border: "#858B62FF"
      borderThickness: 2
      text: "#2F241BFF"

      emptyFill: "#00000000"
      emptyFillHover: "#EFE3CCFF"
      emptyBorder: "#B79A708C"
      emptyBorderThickness: 1
      emptyText: "#7C6B58CC"
    }

    combatStats: {
      hpFill: "#B17D5EFF"
      lustFill: "#880101FF"
      fatigueFill: "#600000FF"
      separator: "#600000FF"
    }

    slot: {
      background: "#F7EFE0CC"
      border: "#B79A70AA"
      text: "#35291FFF"
      selectedBackground: "#E0C9AAFF"
      selectedBorder: "#9F8156FF"
    }

    numberField: {
      background: "#F8F0DCCC"
      text: "#382B22FF"
      secondaryText: "#5B4A3AFF"
    }

    numericStepper: {
      selection: "#B79A7078"
    }

    optionList: {
      background: "#F7EFE0CC"
      text: "#35291FFF"
      selectedBackground: "#F2E1BEFF"
    }

    selector: {
      background: "#F5EBDDCC"
      text: "#382B22FF"
    }

    slider: {
      text: "#382B22FF"
    }

    choiceWheel: {
      fade: "#E6D7BDFF"
      lock: "#8A857CFF"
    }

    dungeonMap: {
      background: "#000000BE"
    }

    dungeonMiniMap: {
      background: "#0A0A0AA0"
    }
  }
}

