{
  require: ["GlobalStyles"]
  id: "CharCreationView"
  styles: {
    TabButton: {
      type: "coc:button"
      width: 200
      height: 60
      horizontalAlign: "center"
      font: { id: "coc:menu", size: 20 }
      states: {
        normal: {
          textColor: "#7C6B58CC"
        }
        hover: {
          textColor: "#2F241BFF"
        }
        selected: {
          backgroundColor: "#E0C9AAFF"
          textColor: "#2F241BFF"
        }
      }
    }
    CharSegment:{
      type: "coc:segmented"
      width: 500
      height: 40
      borderThickness: 2
      states: {
        normal: { textColor: "#7C6B58CC" }
        hover: { textColor: "#2F241BFF" }
        selected: { 
          backgroundColor: "#D5D8B8FF", 
          textColor: "#2F241BFF"
          borderColor: "#858B62"
        }
      }
    }
    FieldLabel: {
      type: "coc:label"
      autoSize: true
      font: { id: "coc:menu", size: 20 }
      textColor: "#5C4A38FF"
      canHit: false
    }
    SectionTitle: {
      type: "coc:label"
      autoSize: true
      font: { id: "coc:menu", size: 34 }
      textColor: "#35291FFF"
      canHit: false
    }
    CreationPanel: {
      type: "coc:grid"
      x: 330
      y: 70
      width: 940
      height: 700
      padding: 28
      spacing: 18
      rows: "auto20"
      autoIndex: true
      visible: false
    }
    CreationStepper: {
      type: "coc:numeric_stepper"
      width: 300
      height: 40
      step: 1
      shiftMultiplier: 10
      fontSize: 18
      buttonWidth: 44
      minusColor: "#F7EFE0CC"
      plusColor: "#F7EFE0CC"
      valueColor: "#F7EFE0CC"
      textColor: "#35291FFF"
      states: {
        normal: {
          minusBackground: "#F7EFE0CC"
          plusBackground: "#F7EFE0CC"
          valueBackground: "#F7EFE0CC"
          minusTextColor: "#35291FFF"
          plusTextColor: "#35291FFF"
          valueTextColor: "#35291FFF"
          borderColor: "#B79A70AA"
          borderThickness: 1
        }
        hover: {
          minusBackground: "#FBF4E6FF"
          plusBackground: "#FBF4E6FF"
          valueBackground: "#FBF4E6FF"
        }
        pressed: {
          minusBackground: "#E8D6B7FF"
          plusBackground: "#E8D6B7FF"
          valueBackground: "#E8D6B7FF"
        }
      }
    }
    CreationWheel: {
      type: "coc:choice_wheel"
      width: 150
      height: 300
      visibleItems: 5
      fade: true
      fadeColor: "#E6D7BDFF"
      fadeTop: 0.18
      fadeBottom: 0.18
      fadeMin: 0.35
      animationSpeed: 0.18
      fontSize: 20
      centerFontSize: 26
      lockColor: "#7C6B58FF"
      lockIcon: "Icons/lock.svg"
      states: {
        normal: { textColor: "#7C6B58CC" }
        hover: { textColor: "#2F241BFF" }
        selected: { backgroundColor: "#E0C9AAFF", textColor: "#2F241BFF" }
      }
    }
    CreationDivider: {
      type: "coc:divider"
      orientation: "vertical"
      thickness: 2
      width: 60
      height: 100
      ornament: true
      font: "coc:menu"
      horizontalAlign: "center"
      verticalAlign: "center"
      states: {
        normal: { color: "#9F8156FF" }
      }
    }
    CreationDetail: {
      type: "coc:label"
      autoSize: true
      width: 400
      wrapWidth: 400
      font: "coc:body"
      textColor: "#5C4A38FF"
      canHit: false
      verticalAlign: "center"
    }
  }
  root: {
    type: "coc:view"
    width: 1600
    height: 900

    children: [
      {
        type: "coc:panel"
        part: "charCreation.background"
        material: "coc:paper"
        sizeType: "fill"
        backgroundColor: "#E6D7BDFF"
        canHit: false
      }
      {
        type: "coc:label"
        width: 1600
        height: 100
        text: { key: "Views.CharCreation.Title" }
        font: { id: "coc:menu", size: 28 }
        textColor: "#382B22FF"
        textHorizontalAlign: "center"
        textVerticalAlign: "center"
        canHit: false
      }
      {
        type: "coc:panel"
        x: 280
        y: 70
        width: 1
        height: 760
        backgroundColor: "#8A663FAA"
        canHit: false
      }
      {
        type: "coc:panel"
        part: "page.tabs"
        x: 0
        y: 100
        width: 300
        height: 560
      }
      {
        type: "coc:grid"
        part: "creation.panel.identity"
        x: 330
        y: 70
        width: 940
        height: 700
        padding: 28
        spacing: 18
        rows: "auto20"
        autoIndex: true
        children: [
          {
            style: "SectionTitle"
            text: { key: "Views.CharCreation.WhoAreYou" }
          }
          {
            type: "coc:text_box"
            part: "creation.name"
            borderThickness: [0, 0, 0, 1]
            borderColor: "#B99A6BFF"
            width: 320
            height: 40
            font: { id: "coc:input", size: 22 }
            cursorColor: "#B99A6BFF"
            textColor: "#B99A6BFF"
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.Age" }
          }
          {
            style: "CharSegment"
            part: "creation.age"
            optionKeys: ["Views.CharCreation.Opt.Child", "Views.CharCreation.Opt.Teenager", "Views.CharCreation.Opt.Adult", "Views.CharCreation.Opt.Elder"]
            value: 2
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.Gender" }
          }
          {
            style: "CharSegment"
            part: "creation.gender"
            optionKeys: ["Views.CharCreation.Opt.Male", "Views.CharCreation.Opt.Female", "Views.CharCreation.Opt.Herm"]
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.Build" }
          }
          {
            style: "CharSegment"
            part: "creation.build"
            optionKeys: ["Views.CharCreation.Opt.Lean", "Views.CharCreation.Opt.Average", "Views.CharCreation.Opt.Thick", "Views.CharCreation.Opt.Girly"]
            value: 1
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.SexualOrientation" }
          }
          {
            style: "CharSegment"
            part: "creation.orientation"
            optionKeys: ["Views.CharCreation.Opt.Males", "Views.CharCreation.Opt.Females", "Views.CharCreation.Opt.Bisexual"]
            value: 2
          }
        ]
      }
      {
        type: "coc:grid"
        part: "creation.panel.body"
        x: 330
        y: 70
        width: 940
        height: 700
        padding: 28
        spacing: 20
        rows: "auto20"
        autoIndex: true
        visible: false
        children: [
          {
            style: "SectionTitle"
            text: { key: "Views.CharCreation.Body" }
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.Height" }
          }
          {
            style: "CreationStepper"
            part: "creation.height"
            min: 107
            max: 244
            value: 170
            unit: "cm"
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.CockLength" }
          }
          {
            style: "CreationStepper"
            part: "creation.cock"
            min: 8
            max: 20
            snapValues: [8, 9, 10, 11, 13, 14, 15, 17, 18, 19, 20]
            value: 14
            unit: "cm"
          }
          {
            style: "FieldLabel"
            part: "creation.breast.label"
            text: { key: "Views.CharCreation.BreastSize" }
          }
          {
            style: "CharSegment"
            part: "creation.breast"
            width: 600
            height: 40
            optionKeys: ["Views.CharCreation.Opt.Flat", "Views.CharCreation.Opt.ACup", "Views.CharCreation.Opt.BCup", "Views.CharCreation.Opt.CCup", "Views.CharCreation.Opt.DCup", "Views.CharCreation.Opt.DDCup"]
          }
        ]
      }
      {
        type: "coc:grid"
        part: "creation.panel.appearance"
        x: 330
        y: 70
        width: 940
        height: 700
        padding: 28
        spacing: 20
        rows: "auto20"
        autoIndex: true
        visible: false
        children: [
          {
            style: "SectionTitle"
            text: { key: "Views.CharCreation.Appearance" }
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.Complexion" }
          }
          {
            style: "CharSegment"
            part: "creation.skin"
            width: 700
            height: 40
            optionKeys: ["Views.CharCreation.Opt.Light", "Views.CharCreation.Opt.Fair", "Views.CharCreation.Opt.Olive", "Views.CharCreation.Opt.Dark", "Views.CharCreation.Opt.Ebony", "Views.CharCreation.Opt.Mahogany", "Views.CharCreation.Opt.Russet"]
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.HairColor" }
          }
          {
            style: "CharSegment"
            part: "creation.hair"
            width: 700
            height: 40
            optionKeys: ["Views.CharCreation.Opt.Blonde", "Views.CharCreation.Opt.Brown", "Views.CharCreation.Opt.Black", "Views.CharCreation.Opt.Red", "Views.CharCreation.Opt.Gray", "Views.CharCreation.Opt.White", "Views.CharCreation.Opt.Auburn"]
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.HairLength" }
          }
          {
            style: "CreationStepper"
            part: "creation.hairLength"
            min: 0
            max: 244
            value: 5
            unit: "cm"
          }
          {
            style: "FieldLabel"
            part: "creation.beardStyle.label"
            text: { key: "Views.CharCreation.BeardStyle" }
          }
          {
            style: "CharSegment"
            part: "creation.beardStyle"
            optionKeys: ["Views.CharCreation.Opt.Normal", "Views.CharCreation.Opt.Goatee", "Views.CharCreation.Opt.CleanCut", "Views.CharCreation.Opt.Mountainman"]
          }
          {
            style: "FieldLabel"
            part: "creation.beardLength.label"
            text: { key: "Views.CharCreation.BeardLength" }
          }
          {
            style: "CharSegment"
            part: "creation.beardLength"
            width: 840
            height: 40
            optionKeys: ["Views.CharCreation.Opt.NoBeard", "Views.CharCreation.Opt.Trim", "Views.CharCreation.Opt.Short", "Views.CharCreation.Opt.Medium", "Views.CharCreation.Opt.MediumLong", "Views.CharCreation.Opt.Long", "Views.CharCreation.Opt.VeryLong"]
          }
        ]
      }
      {
        type: "coc:grid"
        part: "creation.panel.origin"
        x: 330
        y: 70
        width: 940
        height: 700
        padding: 28
        spacing: 20
        rows: "auto20"
        autoIndex: true
        visible: false
        children: [
          {
            style: "SectionTitle"
            text: { key: "Views.CharCreation.Background" }
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.History" }
          }
          {
            type: "coc:grid"
            autoIndex: true
            autoSize: true
            columns: "auto3"
            children: [
              { style: "CreationWheel", part: "creation.history.normal", source: "History", showLocked: true }
              { style: "CreationDivider", part: "creation.history.divider" }
              { style: "CreationDetail", part: "creation.history.detail" }
            ]
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.Virginity" }
          }
          {
            type: "coc:grid"
            autoIndex: true
            autoSize: true
            columns: "auto3"
            children: [
              { style: "CreationWheel", part: "creation.virginity", source: "Virginity", showLocked: true }
              { style: "CreationDivider", part: "creation.virginity.divider" }
              { style: "CreationDetail", part: "creation.virginity.detail" }
            ]
          }
        ]
      }
      {
        type: "coc:grid"
        part: "creation.panel.experience"
        x: 330
        y: 70
        width: 940
        height: 700
        padding: 28
        spacing: 20
        rows: "auto20"
        autoIndex: true
        visible: false
        children: [
          {
            style: "SectionTitle"
            text: { key: "Views.CharCreation.Traits" }
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.Endowment" }
          }
          {
            type: "coc:grid"
            autoIndex: true
            autoSize: true
            columns: "auto3"
            children: [
              { style: "CreationWheel", part: "creation.endowment.options", source: "Endowment", showLocked: true }
              { style: "CreationDivider", part: "creation.endowment.divider" }
              { style: "CreationDetail", part: "creation.endowment.detail" }
            ]
          }
        ]
      }
      {
        type: "coc:grid"
        part: "creation.panel.modes"
        x: 330
        y: 70
        width: 940
        height: 700
        padding: 28
        spacing: 20
        rows: "auto20"
        autoIndex: true
        visible: false
        children: [
          {
            style: "SectionTitle"
            text: { key: "Views.CharCreation.GameModes" }
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.Difficulty" }
          }
          {
            style: "CharSegment"
            part: "creation.difficulty"
            width: 700
            height: 40
            optionKeys: ["Views.CharCreation.Opt.Easy", "Views.CharCreation.Opt.Normal", "Views.CharCreation.Opt.Hard", "Views.CharCreation.Opt.Nightmare", "Views.CharCreation.Opt.Extreme"]
          }
          {
            style: "FieldLabel"
            text: { key: "Views.CharCreation.Hardcore" }
          }
          {
            style: "CharSegment"
            part: "creation.hardcore"
            width: 300
            height: 40
            optionKeys: ["Views.CharCreation.Opt.Off", "Views.CharCreation.Opt.On"]
          }
        ]
      }
      {
        type: "coc:grid"
        part: "creation.panel.summary"
        x: 330
        y: 70
        width: 940
        height: 700
        padding: 28
        spacing: 20
        rows: "auto20"
        autoIndex: true
        visible: false
        children: [
          {
            style: "SectionTitle"
            text: { key: "Views.CharCreation.Summary" }
          }
          {
            type: "coc:label"
              autoSize: true
            part: "creation.summary.text"
            font: "coc:body"
            textColor: "#35291FFF"
            canHit: false
          }
          {
            type: "coc:label"
            autoSize: true
            text: { key: "Views.CharCreation.Footer" }
            font: "coc:body"
            textColor: "#5C4A38FF"
            canHit: false
          }
        ]
      }
      {
        type: "coc:button"
        style: "FooterButton"
        part: "creation.confirm"
        horizontalAlign: "left"
        verticalAlign: "bottom"
        x: 60
        y: -40
        label: { key: "Views.CharCreation.Confirm" }
        onClick: "creation.nav.confirm"
      }
      {
        type: "coc:button"
        style: "FooterButton"
        part: "creation.exit"
        horizontalAlign: "right"
        verticalAlign: "bottom"
        x: -60
        y: -40
        label: { key: "Views.CharCreation.ExitToMainMenu" }
        onClick: "creation.exit"
      }
      {
        type: "coc:label"
        part: "creation.error"
        y: -40
        width: 940
        wrapWidth: 940
        horizontalAlign: "center"
        verticalAlign: "bottom"
        font: { id: "coc:menu", size: 24 }
        textColor: "#B03030FF"
        textHorizontalAlign: "center"
        textVerticalAlign: "center"
        canHit: false
      }
    ]
  }
}
