{
  id: "CharCreationView"
  root: {
    type: "coc:view"
    width: 1600
    height: 900

    children: [
      {
        type: "coc:panel"
        part: "charCreation.background"
        material: "coc:paper"
        sizeType: "fill"
        backgroundColor: "#F2E5C7FF"
        canHit: false
      }
      {
        type: "coc:grid"
        width: 315
        height: 900
        backgroundColor: "#FFFFFF"
      }
      {
        type: "coc:grid"
        autoSize: true
        autoIndex: true
        horizontalAlign: "center"
        rows: "auto3"
        spacing: 12
        padding: [48, 20, 20, 40]
        backgroundColor: "#FFFFFF66"
        children: [
          {
            type: "coc:text_area"
            part: "charCreation.output"
            font: "coc:body"
            layout: "relative"
            width: 930
            height: 750
            backgroundColor: "#FFFFFF66"
            padding: 16
            autoScroll: true
            horizontalAlign: "center"
            borderThickness: 2
            borderColor: "#00000022"
          }
          {
            type: "coc:text_box"
            part: "charCreation.input"
            font: {
              id: "coc:input"
              size: 22
            }
            layout: "relative"
            cursorColor: "#000000FF"
            width: 930
            height: 40
            horizontalAlign: "center"
          }
        ]
      }
    ]
  }
}


