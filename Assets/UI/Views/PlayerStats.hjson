{
  require: ["GlobalStyles"]
  id: "PlayerStats"

  styles: {
    DataBar: {
      type: "coc:bar"
      min: 0
      fillColor: "#B17D5EFF"
      trackColor: "#28000066"
      borderColor: "#704D28FF"
      textColor: "#3B2C1DFF"
      font: { id: "coc:menu", size: 20 }
      width: 272
      height: 30
    }
    DataStatRow: {
      type: "coc:stat_row"
      width: 232
      height: 24
    }
    DataLabal: {
      type: "coc:label"
      font: { id: "coc:menu", size: 15 }
      width: 110
      height: 24
      canHit: false
    }
  }
  root: {
    type: "coc:view"
    sizeType: "fill"
    children: [
      {
        type: "coc:grid"
        sizeType: "fill"
        borderThickness: 2
        rows: "auto7"
        padding: 14
        autoIndex: true
        spacing: 6
        children: [
          {
            type: "coc:label"
            text: { bind: "name" }
            font: {
              id: "coc:menuBold"
              size: 30
            }
            width: 232
            height: 28
            canHit: false
          }
          {
            type: "coc:divider"
            width: 272
            height: 10
            thickness: 1
            ornament: false
            states: { normal: { color: "#9F8156FF" } }
          }
          {
            type: "coc:grid"
            borderThickness: 2
            borderColor: "#00000066"
            width: 272
            height: 272
            children: [
              {
                type: "coc:image"
                width: 240
                height: 240
                horizontalAlign: "center"
                verticalAlign: "center"
              }
            ]
          }
          {
            type: "coc:grid"
            rows: 3
            autoIndex: true
            autoSize: true
            spacing: 6
            children: [
              {
                style: "DataBar"
                label: { key: "Views.PlayerStats.HP" }
                value: { bind: "health" }
                max: { bind: "maxHealth" }
              }
              {
                style: "DataBar"
                label: { key: "Views.PlayerStats.Lust" }
                value: { bind: "lust" }
                max: { bind: "maxLust" }
                marker: { bind: "minLust" }
              }
              {
                style: "DataBar"
                label: { key: "Views.PlayerStats.Fatigue" }
                value: { bind: "fatigue" }
                max: { bind: "maxFatigue" }
              }
            ]
          }
          {
            type: "coc:divider"
            width: 272
            height: 10
            thickness: 1
            ornament: false
            states: { normal: { color: "#9F8156FF" } }
          }
          {
            type: "coc:grid"
            rows: 3
            autoIndex: true
            autoSize: true
            x: 10
            children: [
              {
                style: "DataStatRow"
                label: { key: "Views.PlayerStats.Level" }
                value: { bind: "level" }
                font: { id: "coc:menu", size: 16 }
              }
              {
                style: "DataStatRow"
                label: { key: "Views.PlayerStats.XP" }
                value: { bind: "experience" }
                font: { id: "coc:menu", size: 16 }
              }
              {
                style: "DataStatRow"
                label: { key: "Views.PlayerStats.Gems" }
                value: { bind: "gems" }
                font: { id: "coc:menu", size: 16 }
              }
            ]
          }
          {
            type: "coc:grid"
            spacing: 80
            x: 6
            columns: "auto2"
            autoSize: true
            autoIndex: true
            children: [
              {
                style: "DataLabal"
                text: { bind: "day" }
              }
              {
                style: "DataLabal"
                text: { bind: "time" }
              }
            ]
          }
        ]
      }
    ]
  }
}
