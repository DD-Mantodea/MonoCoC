{
  id: "MenuPageView"
  root: {
    type: "coc:view"
    width: 1600
    height: 900
    children: [
      {
        type: "coc:panel"
        part: "page.background"
        material: "coc:paper"
        sizeType: "fill"
        backgroundColor: "#F2E5C7FF"
        canHit: false
      }
      {
        type: "coc:text_area"
        part: "page.output"
        layout: "relative"
        x: 320
        y: 50
        width: 930
        height: 560
        font: "coc:body"
        backgroundColor: "#FFFFFF66"
        padding: 16
        autoScroll: true
        borderThickness: 2
        borderColor: "#00000022"
      }
      {
        type: "coc:grid"
        part: "page.buttons"
        layout: "relative"
        x: 320
        y: 640
        width: 940
        height: 190
        autoIndex: true
        rows: 3
        columns: 5
        spacing: 8
        children: [
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
          { type: "coc:button", template: "ActionButton" }
        ]
      }
    ]
  }
}
