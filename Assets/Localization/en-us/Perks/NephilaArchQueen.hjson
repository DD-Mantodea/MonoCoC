{
  "Perks.NephilaArchQueen.Desc": "Your womb dwarfs you, serving as a veritable paradise for the countless slime monsters within; as a result, you are a crowned nephila arch queen and can use the Unleash Brood attack to send them forth to fight for you in battle."
  "Perks.NephilaArchQueen.Name": "Nephila Arch Queen"
}
