  "Combat.Terra.MeteorShower.None": "\\n[Themonster] escaped the meteor shower completely untouched.",
  "Combat.Terra.MeteorShower.Hit": "\\n[Themonster] is struck by {0} stones.",
  "Combat.Terra.MeteorShower.Unharmed": "\\n[Themonster] is struck by {0} stones, but seems to be unharmed."
}
