  "Combat.Ability.YamataAttack.Name": "Slash"
  "Combat.Ability.YamataBasic.Description": "Blade work and lashing hair."
  "Combat.Ability.YamataBasic.Name": "Serpentine Flourish"
  "Combat.Ability.YamataCannon1.Description": "Her snakes draw in power for something big."
  "Combat.Ability.YamataCannon1.Name": "Charge the Cannon"
  "Combat.Ability.YamataCannon2.Description": "Eight missiles of corrupted flame."
  "Combat.Ability.YamataCannon2.Name": "Foxfire Cannon"
  "Combat.Ability.YamataDarkFoxfire.Description": "A corrupted purple flame, batted toward you like a missile."
  "Combat.Ability.YamataDarkFoxfire.Name": "Dark Foxfire"
  "Combat.Ability.YamataEntwine.Description": "Snake-hair constricts you and pumps corrupted fire into your veins."
  "Combat.Ability.YamataEntwine.Name": "Entwine"
  "Combat.Ability.YamataIllusionLust.Description": "Copies of herself, and fire from every side."
  "Combat.Ability.YamataIllusionLust.Name": "Illusionary Lust"
  "Combat.Ability.YamataLustAttack.Description": "Her hair snakes bind and violate."
  "Combat.Ability.YamataLustAttack.Name": "Serpent Caress"
  "Combat.Ability.YamataNightmare.Description": "Whispers that drag you into a waking terror."
  "Combat.Ability.YamataNightmare.Name": "Nightmare"
  "Combat.Ability.YamataSeal.Description": "A kitsune seal, locking away one of your options."
