{
  "Npcs.Sylvia.Desc": "You are facing off against {0}a lecherous moth-girl. The lustful gleam in her eyes tells you all you need to know about her intentions, and her lightning-fast movements carry the promise of her fulfilling them. She flits around the forest with her big, beautiful wings, hardly giving you a chance to examine her ample assets, though in the few moments she stays still her complete lack of clothing affords you quite the eyeful."
  "Npcs.Sylvia.Desc.KnownName": "Sylvia, "
  "Npcs.Sylvia.Name": "Sylvia"
  "Npcs.Sylvia.Name.MothGirl": "moth-girl"
}
