{
  "Areas.Lake.Description": "A wide, calm lake stretches out before you."
  "Areas.Lake.Discovery": "Your wanderings take you far and wide across the barren wasteland that surrounds the portal, until the smell of humidity and fresh water alerts you to the nearby lake. With a few quick strides you find a lake so massive the distant shore cannot be seen. Grass and a few sparse trees grow all around it.[pg]<b>You've discovered the Lake!</b>"
  "Areas.Lake.Explore": "You spend an hour walking the shore of the lake."
  "Areas.Lake.Name": "Lake"
}
