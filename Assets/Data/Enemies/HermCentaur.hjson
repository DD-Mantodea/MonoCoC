{
  // 原版 HermCentaur（HermCentaur.hx:14-54，由 monster.mjs 生成骨架后人工校正）
  enemies: [
    {
      id: "coc:herm_centaur"
      type: "coc:herm_centaur"
      nameKey: "Npcs.HermCentaur.Name"
      descriptionKey: "Npcs.HermCentaur.Desc"
      article: "the"
      // 原版先 createCock 再 createVagina，最终代词是 she/her/her（HermCentaur.hx:25-28）
      pronoun1: "she"
      pronoun2: "her"
      pronoun3: "her"
      level: 22
      // 原版 bonusHP = 800 在 HermCentaurEnemy.Configure 里加成（这里留 0，避免重复叠加）
      bonusHealth: 0
      lust: 0
      strength: 100
      toughness: 100
      speed: 65
      intelligence: 65
      libido: 85
      sensitivity: 40
      corruption: 100
      // 原版 gems = 75 + Utils.rand(50)，实例化时在 Configure 里摇；这里只当占位
      gems: 75
      experience: 0
      ai: "coc:herm_centaur_ai"
      weightedLoot: true
      loot: [
        // 原版 this.drop = NO_DROP（HermCentaur.hx:51）：什么都不掉
      ]
    }
  ]
}
