  enemies: [
    {
      id: "coc:marble"
      type: "coc:marble"
      nameKey: "Npcs.Marble.Name"
      descriptionKey: "Npcs.Marble.Desc"
      article: ""
      level: 7
      // 原版没有 bonusHP（Marble.hx:83-118 的 new() 里没有 bonusHP 赋值）
