      // 原版 gems = Utils.rand(5) + 25：实际值在 MarbleEnemy.Configure 里现算，这里只当占位
      gems: 30
      experience: 0
      ai: "coc:marble_ai"
      weightedLoot: true
      loot: [
        // 原版 Marble.hx:113 drop = new WeightedDrop(weapons.L_HAMMR, 1)
        { item: "coc:marbles_hammer", weight: 1 }
      ]
    }
