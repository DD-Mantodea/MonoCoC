{
  // 原版 classes/scenes/monsters/Mimic.hx（由 monster.mjs 生成骨架后人工补 loot）
  enemies: [
    {
      id: "coc:mimic"
      // type 必须与 Contents/Enemies/Vanilla/MimicEnemy.cs 的 [Register] id 完全一致
      type: "coc:mimic"
      nameKey: "Npcs.Mimic.Name"
      descriptionKey: "Npcs.Mimic.Desc"
      article: "the"
      level: 6
      bonusHealth: 0
      lust: 10
      strength: 30
      toughness: 45
      speed: 15
      intelligence: 5
      libido: 45
      sensitivity: 45
      corruption: 100
      // 原版 gems = Utils.rand(30) + 11，随机值在 MimicEnemy.Configure 里掷；这里只是占位
      gems: 30
      experience: 0
      ai: "coc:mimic_ai"
      // 原版 this.pronoun1/2/3 = "it"/"it"/"its"（Mimic.hx:99-101）
      pronoun1: "it"
      pronoun2: "it"
      pronoun3: "its"
      weightedLoot: true
      loot: [
        // 原版 new WeightedDrop().add(consumables.PPHILTR, 4).add(consumables.NUMBOIL, 4).add(consumables.HUMMUS_, 3).add(consumables.INCUBID, 1).add(consumables.SUCMILK, 1).add(consumables.REDUCTO, 1)
        { item: "coc:purity_philter", weight: 4 }
        { item: "coc:numb_oil", weight: 4 }
        { item: "coc:hummanus", weight: 3 }
        { item: "coc:incubi_draft", weight: 1 }
        { item: "coc:succubi_milk", weight: 1 }
        { item: "coc:reducto", weight: 1 }
      ]
    }
  ]
}
