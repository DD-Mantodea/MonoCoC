        { item: "coc:wizard_staff", weight: 1 }
        { item: "coc:fur_loincloth", weight: 1 }
        { item: "coc:lesser_mystic_ring", weight: 1 }
        { item: "coc:lesser_life_ring", weight: 1 }
        { item: "coc:lust_draft", weight: 1 }
        { item: "coc:pink_dye", weight: 1 }
        { item: "coc:blue_dye", weight: 1 }
        { item: "coc:orange_dye", weight: 1 }
        { item: "coc:green_dye", weight: 1 }
        { item: "coc:purple_dye", weight: 1 }
      ]
