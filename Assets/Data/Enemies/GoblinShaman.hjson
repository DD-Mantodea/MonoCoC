      // 原版 gems = Utils.rand(15) + 15，随机值在 GoblinShamanEnemy.ConfigureBody 里掷；这里只是占位
      gems: 15
      experience: 0
      ai: "coc:goblin_shaman_ai"
      weightedLoot: true
      loot: [
        // 原版 new WeightedDrop().add(GOB_ALE, 5).add(W_STAFF, 1).add(FURLOIN, 1).add(MYSTRN1, 1).add(LIFERN1, 1)
        //   .addMany(1, L_DRAFT, PINKDYE, BLUEDYE, ORANGDY, GREEN_D, PURPDYE)
