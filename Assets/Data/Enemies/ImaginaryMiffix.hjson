{
  // 原版 classes/scenes/monsters/ImaginaryMiffix.hx（由 monster.mjs 生成骨架后人工补 loot）
  enemies: [
    {
      id: "coc:imaginary_miffix"
      // type 必须与 Contents/Enemies/Vanilla/ImaginaryMiffixEnemy.cs 的 [Register] id 完全一致
