      nameKey: "Npcs.ImaginaryMiffix.Name"
      descriptionKey: "Npcs.ImaginaryMiffix.Desc"
      article: ""
      level: 1
      bonusHealth: 0
      lust: 40
      strength: 200
      toughness: 200
      speed: 200
      intelligence: 200
      libido: 45
      sensitivity: 45
      corruption: 150
      // 原版 gems = Utils.rand(5) + 5，随机值在 ImaginaryMiffixEnemy.Configure 里掷；这里只是占位
      gems: 5
      experience: 0
      ai: "coc:imaginary_miffix_ai"
      weightedLoot: true
      loot: [
        // 原版 new WeightedDrop().add(consumables.SUCMILK, 3).add(consumables.INCUBID, 3).add(consumables.IMPFOOD, 4).add(shields.WOODSHL, 1)
        { item: "coc:succubi_milk", weight: 3 }
        { item: "coc:incubi_draft", weight: 3 }
        { item: "coc:imp_food", weight: 4 }
        { item: "coc:wooden_shield", weight: 1 }
      ]
    }
  ]
}
