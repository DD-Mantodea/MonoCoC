{
  // 原版 BoneGeneral（scenes/dungeons/manor/BoneGeneral.hx:120 new()）
  // 数值来自构造函数；AI 由 BoneGeneralEnemy.ChooseCombatAction 接管（原版权重表）。
  enemies: [
    {
      id: "coc:bone_general"
      type: "coc:bone_general"
      nameKey: "Npcs.BoneGeneral.Name"
      descriptionKey: "Npcs.BoneGeneral.Desc"
      article: "the"
      level: 20
      bonusHealth: 2000
      lust: 0
      strength: 90
      toughness: 100
      speed: 10
      intelligence: 42
      libido: 45
      sensitivity: 45
      corruption: 100
      // gems 原版是 Utils.rand(5) + 100，Configure 里现算，这里只是占位。
      gems: 100
      experience: 0
      // 原版 pronoun1-3 = it/it/its（BoneGeneral.hx:130-132）
      pronoun1: "it"
      pronoun2: "it"
      pronoun3: "its"
      // 不走数据 AI：原版 performCombatAction（BoneGeneral.hx:49）的权重与 when 条件
      // 全部在 BoneGeneralEnemy.ChooseCombatAction 里，所有分支都返回动作，不会落到空 AI。
      ai: ""
      // 原版 drop = new WeightedDrop()（空表）：不掉落。
      weightedLoot: false
      loot: []
    }
  ]
}
