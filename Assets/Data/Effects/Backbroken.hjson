  descriptionKey: "Combat.Effect.Backbroken.Description"
  kind: "combat"
  duration: 0
  stacking: "refresh"
  combatOnly: true
  flags: ["prevents_physical"]
  blockedText: "Combat.Effect.Backbroken.Blocked"
}
